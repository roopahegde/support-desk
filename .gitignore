# Virtualenv (big, machine-specific, re-creatable from requirements files)
.venv/

# Secrets - never commit these (we ship .env.example instead)
.env

# Python bytecode and tool caches
__pycache__/
.pytest_cache/
.ruff_cache/

# Coverage reports
.coverage
htmlcov/

# Local SQLite databases (re-created by the seed script)
*.db

# Log files: they can contain customer and order details, so they never belong in git
*.log
*.log.[0-9]*
logs/

# Test reports written by the CI command when it is run locally
backend-coverage.xml
backend-test-results.xml
