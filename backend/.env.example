# One key per client, as actor=key pairs separated by commas. The actor name is recorded
# in the audit trail (order_events) as "who made this change", so give every client its own key.
# The MCP servers' key goes in mcp_servers/.env too; the staff key is for curl and Swagger.
BACKEND_API_KEYS=agent:support-desk=change-this,staff:yourname=change-this-too

# Logging: where log lines go. LOG_TARGET is console (default) or file.
LOG_TARGET=console
# Used only when LOG_TARGET=file. Relative paths are relative to the backend folder.
LOG_FILE=logs/backend.log
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
